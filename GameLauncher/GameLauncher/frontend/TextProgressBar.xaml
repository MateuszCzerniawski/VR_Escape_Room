<UserControl x:Class="GameLauncher.frontend.TextProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameLauncher.frontend"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="550">
    <Grid>
        <ProgressBar Name="LoadBar" Margin="0,20,10,20" Minimum="0"
                     Background="#FF5B0F00" Foreground="#FFF6B26B"
                     Maximum="{Binding TotalSteps, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Value="{Binding CurrentStep, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ProgressBar.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </ProgressBar.Resources>
        </ProgressBar>
        <TextBlock Name="InfoLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="26" FontFamily="{StaticResource KaushanFont}" Foreground="#FFF6B26B"
                   Text="{Binding Content, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
