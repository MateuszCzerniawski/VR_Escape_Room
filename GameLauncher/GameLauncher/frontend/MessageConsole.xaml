<UserControl x:Class="GameLauncher.frontend.MessageConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameLauncher.frontend"
             mc:Ignorable="d"
             d:DesignHeight="275" d:DesignWidth="300">
    <Border Name="Border" VerticalAlignment="Center" HorizontalAlignment="Center"  Visibility="Collapsed"
            Background="#CC000000" Width="260" Height="235" CornerRadius="10">
        <ScrollViewer Name="ScrollViewer"  Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MessagesStackPanel" />
        </ScrollViewer>
    </Border>
</UserControl>
